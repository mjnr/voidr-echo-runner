# Copie para .env (gitignored). O modo texto funciona sem nenhuma chave.

# --mode audio (STT/TTS reais)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# TwilioTransport (chamadas PSTN reais)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# URL publica wss:// do Media Streams (ngrok/cloudflared apontando para
# a porta do runner, ver README "Twilio")
TWILIO_STREAM_PUBLIC_URL=

# LLMBrain / playground de personas (echo-runner chat).
# Regra 8.5 do ARCHITECTURE.md: NENHUMA chave de LLM entra no runner —
# o cérebro chama POST {HIVE_URL}/echo/persona-turn (hive é o gateway).
HIVE_URL=http://localhost:3001
HIVE_GATEWAY_TOKEN=
VOIDR_ORG_ID=
