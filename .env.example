# Copie para .env (gitignored). Todo modo exige Hive para as falas tester.

# --mode audio: LiteLLM é obrigatório por padrão, inclusive local.
ECHO_RUNTIME_ENV=local
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_TTS_MODEL=echo-tts-elevenlabs-flash-v2-5@id:2026-07-26
LITELLM_STT_MODEL=echo-stt-deepgram-nova-2@id:2026-07-26
SESSION_STT_SHARED_SECRET=replace-with-at-least-32-random-characters

# Escape hatch exclusivamente test-only, nunca habilitado por padrão:
# VOICE_ALLOW_DIRECT_PROVIDERS=1
# As chaves abaixo não são montadas em cloud/prod.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# TwilioTransport (chamadas PSTN reais)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# URL publica wss:// do Media Streams (ngrok/cloudflared apontando para
# a porta do runner, ver README "Twilio")
TWILIO_STREAM_PUBLIC_URL=

# LLMBrain / playground de personas (echo-runner chat).
# Regra 8.5 do ARCHITECTURE.md: NENHUMA chave de LLM entra no runner —
# o cérebro chama somente POST {HIVE_URL}/echo/persona-turn/v3.
HIVE_URL=http://localhost:3001
HIVE_GATEWAY_TOKEN=
VOIDR_ORG_ID=
# Deve coincidir com o ID imutável de deployment/revisão configurado no Hive;
# o alias mutável deepseek-v4-pro não é aceito como versão.
HIVE_ECHO_PERSONA_V3_MODEL_REVISION=
